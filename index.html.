/* ================= RENDER: RESUMEN ================= */
let lineChart, donutChart;
function renderResumen(){
  const t = totals();
  const heroEl = document.getElementById('heroBalance');
  heroEl.textContent = money(t.balance);
  heroEl.className = 'amount ' + (t.balance < 0 ? 'neg':'pos');
  document.getElementById('statIngresos').textContent = money(t.ingresos);
  document.getElementById('statGastos').textContent = money(t.gastos);
  document.getElementById('statDeuda').textContent = money(t.deuda);
  document.getElementById('statAhorrado').textContent = money(t.ahorrado);

  // -- Line chart: últimos 6 meses --
  const months = [];
  const now = new Date();
  for(let i=5;i>=0;i--){
    const d = new Date(now.getFullYear(), now.getMonth()-i, 1);
    months.push(d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0'));
  }
  const ingByMonth = months.map(k => state.transactions
    .filter(tr=>!tr.isCardPayment && tr.type==='ingreso' && monthKey(tr.date)===k)
    .reduce((s,tr)=>s+tr.amount,0));
  const gasByMonth = months.map(k => state.transactions
    .filter(tr=>!tr.isCardPayment && tr.type==='gasto' && monthKey(tr.date)===k)
    .reduce((s,tr)=>s+tr.amount,0));

  const lineCtx = document.getElementById('lineChart');
  if(lineChart) lineChart.destroy();
  lineChart = new Chart(lineCtx, {
    type:'line',
    data:{
      labels: months.map(monthLabel),
      datasets:[
        { label:'Ingresos', data: ingByMonth, borderColor:'#4FD1AE', backgroundColor:'rgba(79,209,174,0.12)', fill:true, tension:.35, pointRadius:3, pointBackgroundColor:'#4FD1AE' },
        { label:'Gastos', data: gasByMonth, borderColor:'#E8785A', backgroundColor:'rgba(232,120,90,0.10)', fill:true, tension:.35, pointRadius:3, pointBackgroundColor:'#E8785A' }
      ]
    },
    options:{
      responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{ labels:{ color:'#8B93A0', font:{family:'Inter', size:11} } } },
      scales:{
        x:{ ticks:{ color:'#5B6472', font:{size:10.5} }, grid:{ color:'#2A2F38' } },
        y:{ ticks:{ color:'#5B6472', font:{size:10}, callback:v=>{ if(v>=1000000) return (v/1000000)+'M'; if(v>=1000) return (v/1000)+'K'; return v; } }, grid:{ color:'#2A2F38' } }
      }
    }
  });

  // -- Donut chart: gasto por categoría (mes actual) --
  const curMonth = now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0');
  const catTotals = {};
  state.transactions.filter(tr=>!tr.isCardPayment && tr.type==='gasto' && monthKey(tr.date)===curMonth)
    .forEach(tr=>{ catTotals[tr.category] = (catTotals[tr.category]||0) + tr.amount; });
  const catLabels = Object.keys(catTotals);
  const palette = ['#C9793C','#4FD1AE','#E8785A','#7FA6C9','#D9B24C','#9B7FD9','#6FC98F','#C9598A'];

  const donutCtx = document.getElementById('donutChart');
  if(donutChart) donutChart.destroy();
  if(catLabels.length === 0){
    donutChart = null;
    donutCtx.getContext('2d').clearRect(0,0,donutCtx.width,donutCtx.height);
  } else {
    donutChart = new Chart(donutCtx, {
      type:'doughnut',
      data:{
        labels: catLabels,
        datasets:[{ data: catLabels.map(c=>catTotals[c]), backgroundColor: catLabels.map((_,i)=>palette[i%palette.length]), borderColor:'#1B1F26', borderWidth:2 }]
      },
      options:{
        responsive:true, maintainAspectRatio:false,
        plugins:{ legend:{ position:'bottom', labels:{ color:'#8B93A0', font:{family:'Inter', size:11}, boxWidth:10, padding:12 } } },
        cutout:'68%'
      }
    });
  }
}

/* ================= RENDER: CUENTAS ================= */
function renderCuentas(){
  const list = document.getElementById('accountsList');
  if(state.accounts.length === 0){
    list.innerHTML = `<div class="empty-state"><span class="display">Aún no tienes cuentas</span>Crea tu primera cuenta de ahorro o tarjeta de crédito.</div>`;
    return;
  }
  list.innerHTML = state.accounts.map(acc=>{
    const isCard = acc.type === 'tarjeta';
    const val = isCard ? cardDebt(acc) : accountBalance(acc);
    return `<div class="row-card" data-account="${acc.id}">
      <div class="left">
        <div class="name">${escapeHtml(acc.name)}</div>
        <div class="meta">${isCard ? 'Tarjeta de crédito' : 'Cuenta de ahorro'}</div>
      </div>
      <div class="right">
        <div class="amount ${isCard ? 'gasto' : (val<0?'gasto':'ingreso')}">${money(val)}</div>
        <div class="meta">${isCard ? 'deuda' : 'saldo'}</div>
      </div>
    </div>`;
  }).join('');
  list.querySelectorAll('[data-account]').forEach(el=>{
    el.addEventListener('click', ()=> openAccountModal(el.dataset.account));
  });
}

function openAccountModal(id){
  const acc = id ? state.accounts.find(a=>a.id===id) : null;
  const isEdit = !!acc;
  openModal(`
    <h3>${isEdit ? 'Editar cuenta' : 'Nueva cuenta'}</h3>
    <div class="field">
      <label>Tipo</label>
      <div class="seg" id="accTypeSeg">
        <button type="button" data-val="ahorro" class="${(!acc||acc.type==='ahorro')?'active':''}">Ahorro</button>
        <button type="button" data-val="tarjeta" class="${acc&&acc.type==='tarjeta'?'active':''}">Tarjeta</button>
      </div>
    </div>
    <div class="field">
      <label>Nombre</label>
      <input type="text" id="accName" placeholder="Ej: Cuenta principal" value="${acc?escapeHtml(acc.name):''}">
    </div>
    <div class="field" id="accBalanceField">
      <label id="accBalanceLbl">Saldo inicial</label>
      <input type="number" class="mono" id="accBalance" placeholder="0" value="${acc ? (acc.type==='tarjeta'?(acc.initialDebt||0):(acc.initialBalance||0)) : 0}">
    </div>
    <div class="modal-actions">
      ${isEdit ? '<button class="btn danger" id="delAccBtn">Eliminar</button>' : ''}
      <button class="btn ghost full" id="cancelAccBtn">Cancelar</button>
      <button class="btn full" id="saveAccBtn">Guardar</button>
    </div>
  `);
  let selType = acc ? acc.type : 'ahorro';
  document.querySelectorAll('#accTypeSeg button').forEach(b=>{
    b.addEventListener('click', ()=>{
      selType = b.dataset.val;
      document.querySelectorAll('#accTypeSeg button').forEach(x=>x.classList.toggle('active', x===b));
      document.getElementById('accBalanceLbl').textContent = selType==='tarjeta' ? 'Deuda inicial' : 'Saldo inicial';
    });
  });
  document.getElementById('cancelAccBtn').addEventListener('click', closeModal);
  document.getElementById('saveAccBtn').addEventListener('click', ()=>{
    const name = document.getElementById('accName').value.trim();
    const bal = parseFloat(document.getElementById('accBalance').value) || 0;
    if(!name){ alert('Ponle un nombre a la cuenta'); return; }
    if(isEdit){
      acc.name = name; acc.type = selType;
      if(selType==='tarjeta') acc.initialDebt = bal; else acc.initialBalance = bal;
    } else {
      const newAcc = { id: uid(), name, type: selType, createdAt: todayISO() };
      if(selType==='tarjeta') newAcc.initialDebt = bal; else newAcc.initialBalance = bal;
      state.accounts.push(newAcc);
    }
    saveState(); closeModal(); renderAll();
  });
  if(isEdit){
    document.getElementById('delAccBtn').addEventListener('click', ()=>{
      if(confirm('¿Eliminar esta cuenta? Los movimientos asociados no se borrarán pero quedarán sin cuenta.')){
        state.accounts = state.accounts.filter(a=>a.id!==acc.id);
        saveState(); closeModal(); renderAll();
      }
    });
  }
}
document.getElementById('addAccountBtn').addEventListener('click', ()=>openAccountModal(null));

/* ================= RENDER: MOVIMIENTOS ================= */
function renderMovimientos(){
  const list = document.getElementById('txList');
  const txs = [...state.transactions].sort((a,b)=> b.date.localeCompare(a.date) || b.id.localeCompare(a.id));
  if(txs.length === 0){
    list.innerHTML = `<div class="empty-state"><span class="display">Sin movimientos</span>Registra tu primer ingreso o gasto.</div>`;
    return;
  }
  list.innerHTML = txs.map(t=>{
    const acc = state.accounts.find(a=>a.id===t.accountId);
    return `<div class="row-card" data-tx="${t.id}">
      <div class="left">
        <div class="name">${escapeHtml(t.description || t.category)}</div>
        <div class="meta">${formatDateEs(t.date)} · ${acc?escapeHtml(acc.name):'—'}</div>
        <span class="tag">${escapeHtml(t.category)}</span>
      </div>
      <div class="right">
        <div class="amount ${t.type}">${t.type==='ingreso'?'+':'-'}${money(t.amount)}</div>
      </div>
    </div>`;
  }).join('');
  list.querySelectorAll('[data-tx]').forEach(el=>{
    el.addEventListener('click', ()=> openTxModal(el.dataset.tx));
  });
}

function formatDateEs(iso){
  const d = new Date(iso+'T00:00:00');
  return d.toLocaleDateString('es-CL', { day:'2-digit', month:'short' }).replace('.','');
}

function openTxModal(id){
  const tx = id ? state.transactions.find(t=>t.id===id) : null;
  const isEdit = !!tx;
  if(state.accounts.length === 0){
    alert('Primero crea una cuenta en la pestaña Cuentas.');
    return;
  }
  openModal(`
    <h3>${isEdit ? 'Editar movimiento' : 'Nuevo movimiento'}</h3>
    <div class="field">
      <label>Tipo</label>
      <div class="seg" id="txTypeSeg">
        <button type="button" data-val="ingreso" class="${(!tx||tx.type==='ingreso')?'active':''}">Ingreso</button>
        <button type="button" data-val="gasto" class="${tx&&tx.type==='gasto'?'active':''}">Gasto</button>
      </div>
    </div>
    <div class="field">
      <label>Monto</label>
      <input type="number" class="mono" id="txAmount" placeholder="0" value="${tx?tx.amount:''}">
    </div>
    <div class="field">
      <label>Fecha</label>
      <input type="date" id="txDate" value="${tx?tx.date:todayISO()}">
    </div>
    <div class="field">
      <label>Descripción</label>
      <input type="text" id="txDesc" placeholder="Ej: Almuerzo" value="${tx?escapeHtml(tx.description||''):''}">
    </div>
    <div class="field">
      <label>Categoría</label>
      <select id="txCategory">
        ${state.categories.map(c=>`<option value="${escapeHtml(c)}" ${tx&&tx.category===c?'selected':''}>${escapeHtml(c)}</option>`).join('')}
      </select>
      <div class="cat-add-row">
        <input type="text" id="newCatInput" placeholder="Nueva categoría...">
        <button class="btn small ghost" id="addCatBtn" type="button">Agregar</button>
      </div>
    </div>
    <div class="field">
      <label>Cuenta</label>
      <select id="txAccount">
        ${state.accounts.map(a=>`<option value="${a.id}" ${tx&&tx.accountId===a.id?'selected':''}>${escapeHtml(a.name)} ${a.type==='tarjeta'?'(tarjeta)':''}</option>`).join('')}
      </select>
    </div>
    <div class="modal-actions">
      ${isEdit ? '<button class="btn danger" id="delTxBtn">Eliminar</button>' : ''}
      <button class="btn ghost full" id="cancelTxBtn">Cancelar</button>
      <button class="btn full" id="saveTxBtn">Guardar</button>
    </div>
  `);
  let selType = tx ? tx.type : 'gasto';
  document.querySelectorAll('#txTypeSeg button').forEach(b=>{
    b.addEventListener('click', ()=>{
      selType = b.dataset.val;
      document.querySelectorAll('#txTypeSeg button').forEach(x=>x.classList.toggle('active', x===b));
    });
  });
  document.getElementById('addCatBtn').addEventListener('click', ()=>{
    const val = document.getElementById('newCatInput').value.trim();
    if(!val) return;
    if(!state.categories.includes(val)){
      state.categories.push(val);
      saveState();
    }
    const sel = document.getElementById('txCategory');
    if(![...sel.options].some(o=>o.value===val)){
      const opt = document.createElement('option');
      opt.value = val; opt.textContent = val;
      sel.appendChild(opt);
    }
    sel.value = val;
    document.getElementById('newCatInput').value = '';
  });
  document.getElementById('cancelTxBtn').addEventListener('click', closeModal);
  document.getElementById('saveTxBtn').addEventListener('click', ()=>{
    const amount = parseFloat(document.getElementById('txAmount').value);
    const date = document.getElementById('txDate').value || todayISO();
    const description = document.getElementById('txDesc').value.trim();
    const category = document.getElementById('txCategory').value;
    const accountId = document.getElementById('txAccount').value;
    if(!amount || amount <= 0){ alert('Ingresa un monto válido'); return; }
    if(isEdit){
      Object.assign(tx, { type:selType, amount, date, description, category, accountId });
    } else {
      state.transactions.push({ id: uid(), type:selType, amount, date, description, category, accountId });
    }
    saveState(); closeModal(); renderAll();
  });
  if(isEdit){
    document.getElementById('delTxBtn').addEventListener('click', ()=>{
      if(confirm('¿Eliminar este movimiento?')){
        state.transactions = state.transactions.filter(t=>t.id!==tx.id);
        saveState(); closeModal(); renderAll();
      }
    });
  }
}
document.getElementById('addTxBtn').addEventListener('click', ()=>openTxModal(null));

/* ================= RENDER: TARJETA ================= */
function renderTarjeta(){
  const wrap = document.getElementById('tarjetaContent');
  const cards = state.accounts.filter(a=>a.type==='tarjeta');
  if(cards.length === 0){
    wrap.innerHTML = `<div class="empty-state"><span class="display">No tienes tarjeta registrada</span>Crea una cuenta de tipo "Tarjeta" en la pestaña Cuentas.</div>`;
    return;
  }
  wrap.innerHTML = cards.map(c=>{
    const debt = cardDebt(c);
    return `<div class="card-visual">
      <div class="lbl">${escapeHtml(c.name)}</div>
      <div class="debt">${money(debt)}</div>
      <div class="sub">Deuda actual</div>
      <button class="btn" data-pay="${c.id}">Pagar tarjeta</button>
    </div>`;
  }).join('');
  wrap.querySelectorAll('[data-pay]').forEach(btn=>{
    btn.addEventListener('click', ()=> openPayCardModal(btn.dataset.pay));
  });
}

function openPayCardModal(cardId){
  const card = state.accounts.find(a=>a.id===cardId);
  const savings = state.accounts.filter(a=>a.type==='ahorro');
  if(savings.length === 0){
    alert('Necesitas al menos una cuenta de ahorro para pagar la tarjeta.');
    return;
  }
  const debt = cardDebt(card);
  openModal(`
    <h3>Pagar ${escapeHtml(card.name)}</h3>
    <div class="field">
      <label>Deuda actual</label>
      <input class="mono" value="${money(debt)}" disabled>
    </div>
    <div class="field">
      <label>Pagar con</label>
      <select id="paySource">
        ${savings.map(a=>`<option value="${a.id}">${escapeHtml(a.name)} · ${money(accountBalance(a))}</option>`).join('')}
      </select>
    </div>
    <div class="field">
      <label>Monto a pagar</label>
      <input type="number" class="mono" id="payAmount" placeholder="0">
    </div>
    <div class="modal-actions">
      <button class="btn ghost full" id="cancelPayBtn">Cancelar</button>
      <button class="btn full" id="confirmPayBtn">Pagar</button>
    </div>
  `);
  document.getElementById('cancelPayBtn').addEventListener('click', closeModal);
  document.getElementById('confirmPayBtn').addEventListener('click', ()=>{
    const amount = parseFloat(document.getElementById('payAmount').value);
    const sourceId = document.getElementById('paySource').value;
    if(!amount || amount <= 0){ alert('Ingresa un monto válido'); return; }
    state.transactions.push({
      id: uid(), type:'gasto', amount, date: todayISO(),
      description: 'Pago tarjeta de crédito', category: 'Pago tarjeta',
      accountId: sourceId, isCardPayment: true, linkedCardId: cardId
    });
    saveState(); closeModal(); renderAll();
  });
}

/* ================= RENDER: BOLSILLOS ================= */
function renderBolsillos(){
  const list = document.getElementById('pocketsList');
  if(state.pockets.length === 0){
    list.innerHTML = `<div class="empty-state"><span class="display">Sin bolsillos aún</span>Crea uno para juntar plata con un objetivo.</div>`;
    return;
  }
  list.innerHTML = state.pockets.map(p=>`
    <div class="pocket-card">
      <div class="name">${escapeHtml(p.name)}</div>
      <div class="rate ${p.rate>0?'':'none'}">${p.rate>0 ? 'Crece '+p.rate+'% mensual' : 'Sin crecimiento automático'}</div>
      <div class="bal mono">${money(p.balance)}</div>
      <div class="actions">
        <button class="btn small" data-dep="${p.id}">+ Meter</button>
        <button class="btn small ghost" data-wd="${p.id}">− Sacar</button>
        <button class="btn small ghost" data-edit="${p.id}">⋯</button>
      </div>
    </div>
  `).join('');
  list.querySelectorAll('[data-dep]').forEach(b=>b.addEventListener('click', ()=>pocketMove(b.dataset.dep,'in')));
  list.querySelectorAll('[data-wd]').forEach(b=>b.addEventListener('click', ()=>pocketMove(b.dataset.wd,'out')));
  list.querySelectorAll('[data-edit]').forEach(b=>b.addEventListener('click', ()=>openPocketModal(b.dataset.edit)));
}

function pocketMove(id, dir){
  const p = state.pockets.find(x=>x.id===id);
  openModal(`
    <h3>${dir==='in' ? 'Meter dinero a' : 'Sacar dinero de'} ${escapeHtml(p.name)}</h3>
    <div class="field">
      <label>Monto</label>
      <input type="number" class="mono" id="moveAmount" placeholder="0">
    </div>
    <div class="modal-actions">
      <button class="btn ghost full" id="cancelMoveBtn">Cancelar</button>
      <button class="btn full" id="confirmMoveBtn">Confirmar</button>
    </div>
  `);
  document.getElementById('cancelMoveBtn').addEventListener('click', closeModal);
  document.getElementById('confirmMoveBtn').addEventListener('click', ()=>{
    const amt = parseFloat(document.getElementById('moveAmount').value);
    if(!amt || amt<=0){ alert('Ingresa un monto válido'); return; }
    if(dir==='in') p.balance += amt;
    else p.balance = Math.max(0, p.balance - amt);
    saveState(); closeModal(); renderAll();
  });
}

function openPocketModal(id){
  const p = id ? state.pockets.find(x=>x.id===id) : null;
  const isEdit = !!p;
  openModal(`
    <h3>${isEdit?'Editar bolsillo':'Nuevo bolsillo'}</h3>
    <div class="field">
      <label>Nombre</label>
      <input type="text" id="pName" placeholder="Ej: Vacaciones" value="${p?escapeHtml(p.name):''}">
    </div>
    <div class="field">
      <label>Saldo inicial</label>
      <input type="number" class="mono" id="pBalance" value="${p?p.balance:0}">
    </div>
    <div class="field">
      <label>Tasa de crecimiento mensual % (opcional)</label>
      <input type="number" step="0.01" class="mono" id="pRate" placeholder="0" value="${p?(p.rate||''):''}">
    </div>
    <div class="modal-actions">
      ${isEdit ? '<button class="btn danger" id="delPocketBtn">Eliminar</button>' : ''}
      <button class="btn ghost full" id="cancelPocketBtn">Cancelar</button>
      <button class="btn full" id="savePocketBtn">Guardar</button>
    </div>
  `);
  document.getElementById('cancelPocketBtn').addEventListener('click', closeModal);
  document.getElementById('savePocketBtn').addEventListener('click', ()=>{
    const name = document.getElementById('pName').value.trim();
    const balance = parseFloat(document.getElementById('pBalance').value) || 0;
    const rate = parseFloat(document.getElementById('pRate').value) || 0;
    if(!name){ alert('Ponle un nombre al bolsillo'); return; }
    if(isEdit){
      p.name = name; p.balance = balance; p.rate = rate;
    } else {
      state.pockets.push({ id: uid(), name, balance, rate, createdAt: todayISO(), lastGrowth: todayISO() });
    }
    saveState(); closeModal(); renderAll();
  });
  if(isEdit){
    document.getElementById('delPocketBtn').addEventListener('click', ()=>{
      if(confirm('¿Eliminar este bolsillo?')){
        state.pockets = state.pockets.filter(x=>x.id!==p.id);
        saveState(); closeModal(); renderAll();
      }
    });
  }
}
document.getElementById('addPocketBtn').addEventListener('click', ()=>openPocketModal(null));

/* ================= HELPERS ================= */
function escapeHtml(str){
  return String(str).replace(/[&<>"']/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

/* ================= RENDER ALL ================= */
function renderAll(){
  renderResumen();
  renderCuentas();
  renderMovimientos();
  renderTarjeta();
  renderBolsillos();
}

/* ================= INIT ================= */
document.getElementById('todayLabel').textContent = new Date().toLocaleDateString('es-CL', { weekday:'long', day:'numeric', month:'long' });

applyPocketGrowth();
renderAll();

