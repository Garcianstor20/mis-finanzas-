<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Mis Finanzas</title>
<meta name="theme-color" content="#12151A">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Finanzas">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>

<style>
  :root{
    --bg:#12151A;
    --surface:#1B1F26;
    --surface-2:#20252D;
    --border:#2A2F38;
    --copper:#C9793C;
    --copper-soft:rgba(201,121,60,0.15);
    --mint:#4FD1AE;
    --mint-soft:rgba(79,209,174,0.14);
    --coral:#E8785A;
    --coral-soft:rgba(232,120,90,0.14);
    --text:#EDEFF2;
    --text-muted:#8B93A0;
    --text-faint:#5B6472;
    --radius:16px;
    --radius-sm:10px;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{height:100%;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    -webkit-font-smoothing:antialiased;
    padding-bottom:env(safe-area-inset-bottom);
  }
  .mono{font-family:'JetBrains Mono',monospace;}
  .display{font-family:'Fraunces',serif;}

  a,button{font-family:inherit;}

  /* ---------- Layout shell ---------- */
  #app{
    display:flex;
    min-height:100vh;
  }
  nav.sidebar{
    display:none;
  }
  main{
    flex:1;
    max-width:1100px;
    margin:0 auto;
    width:100%;
    padding:28px 20px 100px;
  }

  header.topbar{
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    margin-bottom:24px;
  }
  header.topbar .brand{
    font-family:'Fraunces',serif;
    font-size:22px;
    font-weight:600;
    letter-spacing:-0.01em;
  }
  header.topbar .brand span{color:var(--copper);}
  header.topbar .date{
    font-size:12px;
    color:var(--text-faint);
    font-family:'JetBrains Mono',monospace;
    text-transform:capitalize;
  }

  /* bottom nav (mobile) */
  nav.tabbar{
    position:fixed;
    bottom:0; left:0; right:0;
    background:rgba(27,31,38,0.92);
    backdrop-filter:blur(14px);
    -webkit-backdrop-filter:blur(14px);
    border-top:1px solid var(--border);
    display:flex;
    padding:8px 6px calc(8px + env(safe-area-inset-bottom));
    z-index:40;
  }
  nav.tabbar button{
    flex:1;
    background:none;
    border:none;
    color:var(--text-faint);
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:4px;
    font-size:10.5px;
    padding:6px 2px;
    border-radius:12px;
    cursor:pointer;
    transition:color .15s ease;
  }
  nav.tabbar button svg{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.7;}
  nav.tabbar button.active{color:var(--copper);}

  section.view{display:none;animation:fade .25s ease;}
  section.view.active{display:block;}
  @keyframes fade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}

  /* ---------- Dashboard ---------- */
  .hero{
    background:linear-gradient(160deg, var(--surface) 0%, var(--surface-2) 100%);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:26px 24px;
    margin-bottom:18px;
  }
  .hero .label{
    font-size:12px;
    color:var(--text-muted);
    text-transform:uppercase;
    letter-spacing:.09em;
    margin-bottom:6px;
  }
  .hero .amount{
    font-family:'Fraunces',serif;
    font-size:clamp(34px, 8vw, 52px);
    font-weight:600;
    letter-spacing:-0.02em;
    font-variant-numeric:tabular-nums;
  }
  .hero .amount.neg{color:var(--coral);}
  .hero .amount.pos{color:var(--text);}

  .stat-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
    margin-bottom:22px;
  }
  .stat-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius-sm);
    padding:14px 16px;
  }
  .stat-card .label{
    font-size:11px;
    color:var(--text-muted);
    text-transform:uppercase;
    letter-spacing:.07em;
    display:flex;
    align-items:center;
    gap:6px;
    margin-bottom:8px;
  }
  .stat-card .dot{width:6px;height:6px;border-radius:50%;}
  .stat-card .val{
    font-family:'JetBrains Mono',monospace;
    font-size:19px;
    font-weight:600;
    font-variant-numeric:tabular-nums;
  }
  .dot.mint{background:var(--mint);}
  .dot.coral{background:var(--coral);}
  .dot.copper{background:var(--copper);}

  .chart-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:18px 16px 8px;
    margin-bottom:16px;
  }
  .chart-card h3{
    font-size:13px;
    font-weight:600;
    margin:0 0 14px;
    color:var(--text-muted);
    text-transform:uppercase;
    letter-spacing:.06em;
  }
  .chart-wrap{position:relative; height:220px;}
  .chart-wrap.donut{height:260px;}

  /* ---------- Section headers ---------- */
  .section-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:16px;
  }
  .section-head h2{
    font-family:'Fraunces',serif;
    font-size:22px;
    font-weight:600;
    margin:0;
  }
  .btn{
    background:var(--copper);
    color:#171310;
    border:none;
    border-radius:999px;
    padding:9px 16px;
    font-size:13.5px;
    font-weight:600;
    cursor:pointer;
    display:inline-flex;
    align-items:center;
    gap:6px;
    transition:filter .15s ease, transform .1s ease;
  }
  .btn:active{transform:scale(.97);}
  .btn:hover{filter:brightness(1.08);}
  .btn.ghost{
    background:transparent;
    border:1px solid var(--border);
    color:var(--text);
  }
  .btn.danger{background:var(--coral); color:#241109;}
  .btn.small{padding:6px 12px; font-size:12px;}
  .btn.full{width:100%; justify-content:center;}

  /* ---------- Cards / lists ---------- */
  .card-list{display:flex; flex-direction:column; gap:10px;}
  .row-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius-sm);
    padding:14px 16px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    cursor:pointer;
  }
  .row-card .left{display:flex; flex-direction:column; gap:3px; min-width:0;}
  .row-card .name{font-weight:600; font-size:14.5px;}
  .row-card .meta{font-size:12px; color:var(--text-muted);}
  .row-card .right{text-align:right; flex-shrink:0;}
  .row-card .amount{
    font-family:'JetBrains Mono',monospace;
    font-weight:600;
    font-size:15px;
    font-variant-numeric:tabular-nums;
  }
  .amount.ingreso{color:var(--mint);}
  .amount.gasto{color:var(--coral);}
  .tag{
    display:inline-block;
    font-size:10.5px;
    padding:2px 8px;
    border-radius:999px;
    background:var(--copper-soft);
    color:var(--copper);
    margin-top:2px;
  }
  .empty-state{
    text-align:center;
    padding:48px 20px;
    color:var(--text-faint);
    font-size:13.5px;
    border:1px dashed var(--border);
    border-radius:var(--radius);
  }
  .empty-state .display{display:block; font-size:17px; color:var(--text-muted); margin-bottom:6px;}

  .pocket-card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:16px;
  }
  .pocket-card .name{font-weight:600; font-size:15px; margin-bottom:2px;}
  .pocket-card .rate{font-size:11.5px; color:var(--mint); margin-bottom:10px;}
  .pocket-card .rate.none{color:var(--text-faint);}
  .pocket-card .bal{
    font-family:'JetBrains Mono',monospace;
    font-size:24px;
    font-weight:600;
    margin-bottom:12px;
  }
  .pocket-card .actions{display:flex; gap:8px;}

  .card-visual{
    background:linear-gradient(135deg, #241A12 0%, #171310 60%);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:22px;
    position:relative;
    overflow:hidden;
    margin-bottom:16px;
  }
  .card-visual::after{
    content:'';
    position:absolute;
    right:-40px; top:-40px;
    width:160px; height:160px;
    border-radius:50%;
    background:radial-gradient(circle, var(--copper-soft), transparent 70%);
  }
  .card-visual .lbl{font-size:11px; color:var(--text-muted); text-transform:uppercase; letter-spacing:.08em; margin-bottom:8px;}
  .card-visual .debt{font-family:'JetBrains Mono',monospace; font-size:30px; font-weight:700; color:var(--coral); margin-bottom:4px;}
  .card-visual .sub{font-size:12px; color:var(--text-faint); margin-bottom:18px;}

  /* ---------- Modal ---------- */
  .overlay{
    position:fixed; inset:0;
    background:rgba(8,9,11,0.6);
    backdrop-filter:blur(3px);
    display:none;
    align-items:flex-end;
    justify-content:center;
    z-index:100;
  }
  .overlay.open{display:flex;}
  .modal{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:20px 20px 0 0;
    width:100%;
    max-width:480px;
    max-height:88vh;
    overflow-y:auto;
    padding:20px 20px calc(24px + env(safe-area-inset-bottom));
    animation:slideup .22s cubic-bezier(.32,.72,0,1);
  }
  @media(min-width:640px){
    .overlay{align-items:center;}
    .modal{border-radius:var(--radius); max-height:80vh;}
  }
  @keyframes slideup{from{transform:translateY(24px); opacity:0;} to{transform:translateY(0); opacity:1;}}
  .modal h3{
    font-family:'Fraunces',serif;
    font-size:19px;
    margin:0 0 16px;
  }
  .field{margin-bottom:14px;}
  .field label{
    display:block;
    font-size:12px;
    color:var(--text-muted);
    margin-bottom:6px;
    text-transform:uppercase;
    letter-spacing:.05em;
  }
  .field input, .field select, .field textarea{
    width:100%;
    background:var(--surface-2);
    border:1px solid var(--border);
    border-radius:10px;
    padding:11px 12px;
    color:var(--text);
    font-size:15px;
    font-family:'Inter',sans-serif;
  }
  .field input.mono, .field select.mono{font-family:'JetBrains Mono',monospace;}
  .field input:focus, .field select:focus, .field textarea:focus{
    outline:none; border-color:var(--copper);
  }
  .seg{display:flex; gap:8px;}
  .seg button{
    flex:1;
    background:var(--surface-2);
    border:1px solid var(--border);
    color:var(--text-muted);
    padding:10px;
    border-radius:10px;
    font-size:13.5px;
    font-weight:600;
    cursor:pointer;
  }
  .seg button.active{
    border-color:var(--copper);
    color:var(--copper);
    background:var(--copper-soft);
  }
  .modal-actions{display:flex; gap:10px; margin-top:18px;}
  .cat-add-row{display:flex; gap:8px; margin-top:8px;}
  .cat-add-row input{flex:1;}

  /* ---------- Desktop ---------- */
  @media(min-width:900px){
    #app{max-width:1200px; margin:0 auto;}
    nav.tabbar{display:none;}
    nav.sidebar{
      display:flex;
      flex-direction:column;
      width:230px;
      padding:28px 14px;
      border-right:1px solid var(--border);
      gap:4px;
      position:sticky; top:0; height:100vh;
    }
    nav.sidebar .brand{
      font-family:'Fraunces',serif;
      font-size:21px;
      font-weight:600;
      margin:6px 10px 26px;
    }
    nav.sidebar .brand span{color:var(--copper);}
    nav.sidebar button{
      display:flex;
      align-items:center;
      gap:10px;
      background:none;
      border:none;
      color:var(--text-muted);
      padding:11px 12px;
      border-radius:10px;
      font-size:14px;
      font-weight:500;
      cursor:pointer;
      text-align:left;
    }
    nav.sidebar button svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.7;flex-shrink:0;}
    nav.sidebar button.active{background:var(--surface); color:var(--copper);}
    main{padding:36px 40px 60px;}
    .stat-grid{grid-template-columns:repeat(4,1fr);}
    .charts-row{display:grid; grid-template-columns:1.4fr 1fr; gap:16px;}
    .pockets-grid{display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:14px;}
  }

  ::-webkit-scrollbar{width:8px; height:8px;}
  ::-webkit-scrollbar-thumb{background:var(--border); border-radius:8px;}

  .install-hint{
    background:var(--copper-soft);
    border:1px solid rgba(201,121,60,.35);
    color:var(--copper);
    font-size:12.5px;
    padding:10px 14px;
    border-radius:12px;
    margin-bottom:18px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
  }
  .install-hint button{background:none; border:none; color:var(--copper); font-size:16px; cursor:pointer; line-height:1;}
</style>
</head>
<body>

<div id="app">
  <nav class="sidebar">
    <div class="brand">Mis<span>$</span>Finanzas</div>
    <button data-tab="resumen"><svg viewBox="0 0 24 24"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg>Resumen</button>
    <button data-tab="cuentas"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/></svg>Cuentas</button>
    <button data-tab="movimientos"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10"/></svg>Movimientos</button>
    <button data-tab="tarjeta"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>Tarjeta</button>
    <button data-tab="bolsillos"><svg viewBox="0 0 24 24"><path d="M20 7h-3V6a3 3 0 00-6 0v1H8a2 2 0 00-2 2l-1 9a2 2 0 002 2h10a2 2 0 002-2l-1-9a2 2 0 00-2-2z"/></svg>Bolsillos</button>
  </nav>

  <main>
    <header class="topbar">
      <div class="brand">Mis<span>$</span>Finanzas</div>
      <div class="date" id="todayLabel"></div>
    </header>

    <div class="install-hint" id="installHint" style="display:none;">
      <span>Toca compartir <strong>→ Añadir a pantalla de inicio</strong> para instalar la app.</span>
      <button id="dismissHint">✕</button>
    </div>

    <!-- RESUMEN -->
    <section class="view active" id="view-resumen">
      <div class="hero">
        <div class="label">Balance total</div>
        <div class="amount" id="heroBalance">$0</div>
      </div>
      <div class="stat-grid">
        <div class="stat-card"><div class="label"><span class="dot mint"></span>Ingresos</div><div class="val" id="statIngresos">$0</div></div>
        <div class="stat-card"><div class="label"><span class="dot coral"></span>Gastos</div><div class="val" id="statGastos">$0</div></div>
        <div class="stat-card"><div class="label"><span class="dot copper"></span>Deuda tarjeta</div><div class="val" id="statDeuda">$0</div></div>
        <div class="stat-card"><div class="label"><span class="dot mint"></span>Ahorrado</div><div class="val" id="statAhorrado">$0</div></div>
      </div>
      <div class="charts-row">
        <div class="chart-card">
          <h3>Ingresos vs. gastos por mes</h3>
          <div class="chart-wrap"><canvas id="lineChart"></canvas></div>
        </div>
        <div class="chart-card">
          <h3>Gastos por categoría</h3>
          <div class="chart-wrap donut"><canvas id="donutChart"></canvas></div>
        </div>
      </div>
    </section>

    <!-- CUENTAS -->
    <section class="view" id="view-cuentas">
      <div class="section-head">
        <h2>Cuentas</h2>
        <button class="btn" id="addAccountBtn">+ Nueva</button>
      </div>
      <div class="card-list" id="accountsList"></div>
    </section>

    <!-- MOVIMIENTOS -->
    <section class="view" id="view-movimientos">
      <div class="section-head">
        <h2>Movimientos</h2>
        <button class="btn" id="addTxBtn">+ Nuevo</button>
      </div>
      <div class="card-list" id="txList"></div>
    </section>

    <!-- TARJETA -->
    <section class="view" id="view-tarjeta">
      <div class="section-head"><h2>Tarjeta de crédito</h2></div>
      <div id="tarjetaContent"></div>
    </section>

    <!-- BOLSILLOS -->
    <section class="view" id="view-bolsillos">
      <div class="section-head">
        <h2>Bolsillos de ahorro</h2>
        <button class="btn" id="addPocketBtn">+ Nuevo</button>
      </div>
      <div class="pockets-grid" id="pocketsList"></div>
    </section>
  </main>

  <nav class="tabbar">
    <button data-tab="resumen"><svg viewBox="0 0 24 24"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg>Resumen</button>
    <button data-tab="cuentas"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18"/></svg>Cuentas</button>
    <button data-tab="movimientos"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10"/></svg>Movs.</button>
    <button data-tab="tarjeta"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>Tarjeta</button>
    <button data-tab="bolsillos"><svg viewBox="0 0 24 24"><path d="M20 7h-3V6a3 3 0 00-6 0v1H8a2 2 0 00-2 2l-1 9a2 2 0 002 2h10a2 2 0 002-2l-1-9a2 2 0 00-2-2z"/></svg>Bolsillos</button>
  </nav>
</div>

<div class="overlay" id="overlay">
  <div class="modal" id="modalBody"></div>
</div>

<script>
/* ================= ESTADO ================= */
const STORAGE_KEY = 'misFinanzasData_v2';
const DEFAULT_CATEGORIES = ['Comida','Transporte','Hogar','Entretenimiento','Salud','Otros'];

function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,7); }

function loadState(){
  const raw = localStorage.getItem(STORAGE_KEY);
  if(raw){
    try{ return JSON.parse(raw); }catch(e){ /* fall through */ }
  }
  return {
    accounts: [],
    pockets: [],
    transactions: [],
    categories: [...DEFAULT_CATEGORIES]
  };
}

let state = loadState();

function saveState(){
  localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
}

/* ================= UTILIDADES ================= */
const fmt = new Intl.NumberFormat('es-CL', { style:'currency', currency:'CLP', maximumFractionDigits:0 });
function money(n){ return fmt.format(Math.round(n||0)); }

function todayISO(){ return new Date().toISOString().slice(0,10); }

function monthKey(dateStr){ return dateStr.slice(0,7); } // YYYY-MM

function monthLabel(key){
  const [y,m] = key.split('-');
  const d = new Date(parseInt(y), parseInt(m)-1, 1);
  return d.toLocaleDateString('es-CL', { month:'short', year:'2-digit' }).replace('.','');
}

/* ================= CRECIMIENTO MENSUAL DE BOLSILLOS ================= */
function applyPocketGrowth(){
  const now = new Date();
  const nowKey = now.getFullYear()*12 + now.getMonth();
  let changed = false;
  state.pockets.forEach(p => {
    if(!p.rate || p.rate <= 0) return;
    if(!p.lastGrowth) p.lastGrowth = p.createdAt || todayISO();
    const last = new Date(p.lastGrowth);
    const lastKey = last.getFullYear()*12 + last.getMonth();
    let months = nowKey - lastKey;
    if(months > 0){
      for(let i=0;i<months;i++){
        p.balance = p.balance * (1 + p.rate/100);
      }
      p.lastGrowth = todayISO();
      changed = true;
    }
  });
  if(changed) saveState();
}

/* ================= CÁLCULOS DERIVADOS ================= */
function accountBalance(acc){
  if(acc.type === 'ahorro'){
    let bal = acc.initialBalance || 0;
    state.transactions.forEach(t => {
      if(t.accountId !== acc.id) return;
      if(t.type === 'ingreso') bal += t.amount;
      else bal -= t.amount;
    });
    return bal;
  }
  return null;
}

function cardDebt(acc){
  if(acc.type !== 'tarjeta') return null;
  let debt = acc.initialDebt || 0;
  state.transactions.forEach(t => {
    if(t.type === 'gasto' && t.accountId === acc.id && !t.isCardPayment) debt += t.amount;
    if(t.isCardPayment && t.linkedCardId === acc.id) debt -= t.amount;
  });
  return Math.max(0, debt);
}

function totals(){
  let ingresos = 0, gastos = 0;
  state.transactions.forEach(t => {
    if(t.isCardPayment) return; // transferencia, no gasto real
    if(t.type === 'ingreso') ingresos += t.amount;
    else gastos += t.amount;
  });
  const deuda = state.accounts.filter(a=>a.type==='tarjeta').reduce((s,a)=>s+cardDebt(a),0);
  const ahorrado = state.pockets.reduce((s,p)=>s+p.balance,0);
  const balance = state.accounts.filter(a=>a.type==='ahorro').reduce((s,a)=>s+accountBalance(a),0);
  return { ingresos, gastos, deuda, ahorrado, balance };
}

/* ================= NAVEGACIÓN ================= */
function setTab(tab){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById('view-'+tab).classList.add('active');
  document.querySelectorAll('[data-tab]').forEach(b=>b.classList.toggle('active', b.dataset.tab===tab));
  renderAll();
}
document.querySelectorAll('[data-tab]').forEach(btn=>{
